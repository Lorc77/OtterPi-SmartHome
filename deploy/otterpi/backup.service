[Unit]
Description=Backup OtterPi databases to NAS
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/otterbox

[Service]
Type=oneshot
User=makki
Group=makki
EnvironmentFile=/etc/loggerpi-otterpi/otterpi.env
Environment="PYTHONPATH=/opt/loggerpi-otterpi:/opt/loggerpi-otterpi/model"
ExecStart=/usr/bin/python3 /opt/loggerpi-otterpi/backup.py
StandardOutput=journal
StandardError=journal
